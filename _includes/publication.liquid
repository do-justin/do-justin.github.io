{% assign work = include.work %}
<article class="publication" id="{{ work.id | escape }}">
  <h3>{% if work.links.size > 0 %}<a href="{{ work.links[0].url | escape }}">{{ work.title | escape }}</a>{% else %}{{ work.title | escape }}{% endif %}</h3>
  <p class="authors">{% for author in work.authors %}{% if forloop.index0 == work.owner_author_index %}<strong>{{ author.display | escape }}</strong>{% else %}{{ author.display | escape }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}.</p>
  <p class="venue"><cite>{{ work.venue | escape }}</cite>. {{ work.date_label | escape }}{% if work.volume %};{{ work.volume | escape }}{% endif %}{% if work.issue %}({{ work.issue | escape }}){% endif %}{% if work.pages %}:{{ work.pages | escape }}{% endif %}.</p>
  <p class="work-status">{% if work.subtype and work.kind != 'preprint' %}{{ work.subtype | escape }}<span aria-hidden="true"> · </span>{% endif %}{{ work.status_label | escape }}{% if work.doi_scope == 'supplement' %}<span aria-hidden="true"> · </span>DOI identifies the supplement{% endif %}{% if work.citations %}<span aria-hidden="true"> · </span>{{ work.citations.count }} Crossref citation{% unless work.citations.count == 1 %}s{% endunless %} ({{ work.citations.as_of | date: '%b %-d, %Y' }}){% endif %}</p>
  <div class="publication-actions">{% for link in work.links %}<a href="{{ link.url | escape }}">{{ link.label | escape }}<span class="sr-only">: {{ work.title | escape }}</span></a>{% endfor %}{% unless work.kind == 'presentation' %}<a href="{{ '/assets/bib/' | append: work.id | append: '.bib' | relative_url }}">BibTeX<span class="sr-only">: {{ work.title | escape }}</span></a>{% endunless %}</div>
  {% if work.summary %}<details><summary>{{ work.summary.kind | escape }}<span class="sr-only">: {{ work.title | escape }}</span></summary><div class="disclosure"><p>{{ work.summary.text | escape }}</p><p class="summary-source">{% if work.summary.kind == 'Summary' %}Original research summary.{% else %}Publisher abstract.{% endif %} <a href="{{ work.summary.source | escape }}">Source</a></p></div></details>{% endif %}
  {% if work.related_ids.size > 0 %}<details class="related"><summary>Related outputs<span class="sr-only">: {{ work.title | escape }}</span></summary><ul>{% for id in work.related_ids %}{% assign related = site.data.publications.works | where: 'id', id | first %}<li><a href="{{ '/publications/#' | append: id | relative_url }}">{{ related.subtype | default: related.kind | escape }}: {{ related.title | escape }}</a></li>{% endfor %}</ul></details>{% endif %}
</article>
